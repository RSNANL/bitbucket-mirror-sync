{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mirror management authentication configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["github", "cloudflare", "bitbucket"],
  "properties": {
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id"],
      "properties": {
        "client_id": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "account_id", "redirect_uri", "scopes"],
      "properties": {
        "client_id": { "type": ["string", "null"], "minLength": 1 },
        "account_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{32}$"
        },
        "redirect_uri": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{2,5}/[A-Za-z0-9/_-]+$"
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bitbucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "redirect_uri"],
      "properties": {
        "client_id": { "type": ["string", "null"], "minLength": 1 },
        "redirect_uri": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{2,5}/[A-Za-z0-9/_-]+$"
        }
      }
    }
  }
}
