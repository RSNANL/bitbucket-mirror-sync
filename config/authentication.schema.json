{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mirror management authentication configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["github", "cloudflare", "bitbucket"],
  "properties": {
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id"],
      "properties": {
        "client_id": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "account_id"],
      "properties": {
        "client_id": { "type": ["string", "null"], "minLength": 1 },
        "account_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{32}$"
        }
      }
    },
    "bitbucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id"],
      "properties": {
        "client_id": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
